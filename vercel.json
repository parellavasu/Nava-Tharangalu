{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!assets|favicon|logo_social|dummy.pdf).*).*",
      "destination": "/index.html"
    }
  ]
}
